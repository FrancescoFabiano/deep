{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_NEURALNETS": "OFF",
        "ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_NEURALNETS": "OFF",
        "ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "debug-nn",
      "displayName": "Debug + NN",
      "binaryDir": "${sourceDir}/cmake-build-debug-nn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_NEURALNETS": "ON",
        "ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "release-nn",
      "displayName": "Release + NN",
      "binaryDir": "${sourceDir}/cmake-build-release-nn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_NEURALNETS": "ON",
        "ENABLE_CUDA": "OFF"
      }
    }
  ]
}