(define (problem g-bw-3-3-2-clumsy-w2-disj-s1)      ;; generated: 3 agents (1 clumsy); 3 blocks; 2 tables; 2 worlds; goal disj; seed 1 (training/validation only)
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 - block
        t1 t2 - table
    )

    (:agents
        A B - precise-agent
        C - clumsy-agent
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at C t2)
    )

    (:init
        :worlds
            (w1 w2)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move C b1)
                    (can-move C b2)
                    (can-move C b3)
                    (on-table b1 t1)
                    (on b3 b1)
                    (clear b3)
                    (on-table b2 t2)
                    (clear b2)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move C b1)
                    (can-move C b2)
                    (can-move C b3)
                    (on-table b3 t1)
                    (clear b3)
                    (on-table b2 t2)
                    (on b1 b2)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
            )
        :designated (w1)
    )

    (:goal
        ([C]
            (and
                (on-table b2 t2)
                (or
                    (on b3 b2)
                    (on-table b2 t2) )
                (or
                    (on-table b1 t1)
                    (on-table b3 t1) )))
    )
)
