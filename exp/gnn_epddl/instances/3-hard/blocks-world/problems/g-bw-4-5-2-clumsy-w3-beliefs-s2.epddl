(define (problem g-bw-4-5-2-clumsy-w3-beliefs-s2)      ;; generated: 4 agents (2 clumsy); 5 blocks; 2 tables; 3 worlds; goal beliefs; seed 2 (training/validation only)
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 - block
        t1 t2 - table
    )

    (:agents
        A B - precise-agent
        C D - clumsy-agent
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at C t2)
        (at D t1)
        (at D t2)
    )

    (:init
        :worlds
            (w1 w2 w3)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w))
             D (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move C b1)
                    (can-move C b2)
                    (can-move C b3)
                    (can-move C b4)
                    (can-move C b5)
                    (can-move D b1)
                    (can-move D b2)
                    (can-move D b3)
                    (can-move D b4)
                    (can-move D b5)
                    (on-table b5 t1)
                    (clear b5)
                    (on-table b4 t2)
                    (on b2 b4)
                    (on b3 b2)
                    (on b1 b3)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move C b1)
                    (can-move C b2)
                    (can-move C b3)
                    (can-move C b4)
                    (can-move C b5)
                    (can-move D b1)
                    (can-move D b2)
                    (can-move D b3)
                    (can-move D b4)
                    (can-move D b5)
                    (on-table b5 t1)
                    (on b1 b5)
                    (on b4 b1)
                    (on b3 b4)
                    (clear b3)
                    (on-table b2 t2)
                    (clear b2)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move C b1)
                    (can-move C b2)
                    (can-move C b3)
                    (can-move C b4)
                    (can-move C b5)
                    (can-move D b1)
                    (can-move D b2)
                    (can-move D b3)
                    (can-move D b4)
                    (can-move D b5)
                    (on-table b5 t1)
                    (on b4 b5)
                    (on b2 b4)
                    (on b1 b2)
                    (clear b1)
                    (on-table b3 t2)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on b1 b2)
            ([B] (on b3 b4))
            ([C] (on-table b5 t2))
        )
    )
)
