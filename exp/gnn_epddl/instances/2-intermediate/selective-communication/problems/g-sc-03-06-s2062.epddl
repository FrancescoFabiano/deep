(define (problem g-sc-03-06-s2062)    ;; 3 agents; 6 rooms (generated, seed 2062)
    (:domain selective-communication)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
    )

    (:agents
        A B C
    )

    (:objects
        room1 room2 room3 room4 room5 room6 - room
    )

    (:facts-init
        (neighbor room1 room2) (neighbor room2 room3) (neighbor room3 room4) (neighbor room4 room5) (neighbor room5 room6)
        (leftmost room1)
        (rightmost room6)
    )

    (:init
        :worlds (w-info w-not-info)
        :relations
            (A (:forall (?x ?y - world) (?x ?y))
             B (:forall (?x ?y - world) (?x ?y))
             C (:forall (?x ?y - world) (?x ?y)) )
        :labels
            (w-info
                (:and
                    (info)
                    (at A room3) (at B room4) (at C room5)
                    (close A B) (close B A) (close B C) (close C B)
                    (:forall (?i - agent)
                        (close ?i ?i) ))
             w-not-info
                (:and
                    (at A room3) (at B room4) (at C room5)
                    (close A B) (close B A) (close B C) (close C B)
                    (:forall (?i - agent)
                        (close ?i ?i) )))
        :designated
            (w-info)
    )

    (:goal
        ([All] (info))
    )
)
