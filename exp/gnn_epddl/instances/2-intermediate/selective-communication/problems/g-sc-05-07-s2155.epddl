(define (problem g-sc-05-07-s2155)    ;; 5 agents; 7 rooms (generated, seed 2155)
    (:domain selective-communication)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
    )

    (:agents
        A B C D E
    )

    (:objects
        room1 room2 room3 room4 room5 room6 room7 - room
    )

    (:facts-init
        (neighbor room1 room2) (neighbor room2 room3) (neighbor room3 room4) (neighbor room4 room5) (neighbor room5 room6) (neighbor room6 room7)
        (leftmost room1)
        (rightmost room7)
    )

    (:init
        :worlds (w-info w-not-info)
        :relations
            (A (:forall (?x ?y - world) (?x ?y))
             B (:forall (?x ?y - world) (?x ?y))
             C (:forall (?x ?y - world) (?x ?y))
             D (:forall (?x ?y - world) (?x ?y))
             E (:forall (?x ?y - world) (?x ?y)) )
        :labels
            (w-info
                (:and
                    (info)
                    (at A room1) (at B room2) (at C room4) (at D room5) (at E room6)
                    (close A B) (close B A) (close C D) (close D C) (close D E) (close E D)
                    (:forall (?i - agent)
                        (close ?i ?i) ))
             w-not-info
                (:and
                    (at A room1) (at B room2) (at C room4) (at D room5) (at E room6)
                    (close A B) (close B A) (close C D) (close D C) (close D E) (close E D)
                    (:forall (?i - agent)
                        (close ?i ?i) )))
        :designated
            (w-info)
    )

    (:goal
        ([All] (info))
    )
)
