;; Generated by gnn_epddl.generators.cloud_scheduling (training/validation instance, not a benchmark problem)
;; Tasks (task1:sched, task2:sched, task3:sched); 3 tenants; owners tenant1, tenant2, tenant3; success path for every task.
;; Estimated minimal plan length: 12
;;   (fresh=6, sched=4, exec=3 actions per task)
(define (problem g-cloud-15-len12)

    (:domain cloud-scheduling)

    (:requirements
        :typing
        :facts
        :finitary-S5-theories
        :modal-goals
        :knowing-whether
        :negative-goals
    )

    (:agents scheduler observer reporter tenant1 tenant2 tenant3)

    (:objects
        task1 task2 task3 - task
    )

    (:facts-init
        (owner task1 tenant1)
        (owner task2 tenant2)
        (owner task3 tenant3)
    )

    (:init
        (:and
            (submitted task1)
            (submitted task2)
            (submitted task3)

            (not (size-large task1))
            (not (size-large task2))
            (not (size-large task3))

            (not (completed task1))
            (not (validated task1))
            (not (executing task1))
            (not (failed task1))
            (scheduled task1)
            (not (rescheduled task1))
            (not (completed task2))
            (not (validated task2))
            (not (executing task2))
            (not (failed task2))
            (scheduled task2)
            (not (rescheduled task2))
            (not (completed task3))
            (not (validated task3))
            (not (executing task3))
            (not (failed task3))
            (scheduled task3)
            (not (rescheduled task3))

            ([C. All]
                (and
                    (submitted task1)
                    (submitted task2)
                    (submitted task3)
                    (not (completed task1))
                    (not (executing task1))
                    (not (failed task1))
                    (scheduled task1)
                    (not (rescheduled task1))
                    (not (completed task2))
                    (not (executing task2))
                    (not (failed task2))
                    (scheduled task2)
                    (not (rescheduled task2))
                    (not (completed task3))
                    (not (executing task3))
                    (not (failed task3))
                    (scheduled task3)
                    (not (rescheduled task3))
                ))
        )
    )

    (:goal
        (and
            ;; (a) ontic completion + validation
            (completed task1)
            (completed task2)
            (completed task3)

            (validated task1)
            (validated task2)
            (validated task3)

            ;; (b) scheduler epistemic closure
            ([scheduler] (completed task1))
            ([scheduler] (completed task2))
            ([scheduler] (completed task3))

            ;; (c) each tenant privately knows its own tasks
            ([tenant1] (completed task1))
            ([tenant2] (completed task2))
            ([tenant3] (completed task3))

            ;; (d) privacy: non-owning tenant must not know
            (not ([tenant2] (completed task1)))
            (not ([tenant3] (completed task1)))
            (not ([tenant1] (completed task2)))
            (not ([tenant3] (completed task2)))
            (not ([tenant1] (completed task3)))
            (not ([tenant2] (completed task3)))
        )
    )
)
