;; Generated by gnn_epddl.generators.cloud_scheduling (training/validation instance, not a benchmark problem)
;; Tasks (task1:fresh, task2:sched); 3 tenants; owners tenant1, tenant3; success path for every task.
;; Estimated minimal plan length: 10
;;   (fresh=6, sched=4, exec=3 actions per task)
(define (problem g-cloud-05-len10)

    (:domain cloud-scheduling)

    (:requirements
        :typing
        :facts
        :finitary-S5-theories
        :modal-goals
        :knowing-whether
        :negative-goals
    )

    (:agents scheduler observer reporter tenant1 tenant2 tenant3)

    (:objects
        task1 task2 - task
    )

    (:facts-init
        (owner task1 tenant1)
        (owner task2 tenant3)
    )

    (:init
        (:and
            (submitted task1)
            (submitted task2)

            (not (size-large task1))
            (not (size-large task2))

            (not (completed task1))
            (not (validated task1))
            (not (executing task1))
            (not (failed task1))
            (not (scheduled task1))
            (not (rescheduled task1))
            (not (completed task2))
            (not (validated task2))
            (not (executing task2))
            (not (failed task2))
            (scheduled task2)
            (not (rescheduled task2))

            ([C. All]
                (and
                    (submitted task1)
                    (submitted task2)
                    (not (completed task1))
                    (not (executing task1))
                    (not (failed task1))
                    (not (scheduled task1))
                    (not (rescheduled task1))
                    (not (completed task2))
                    (not (executing task2))
                    (not (failed task2))
                    (scheduled task2)
                    (not (rescheduled task2))
                ))
        )
    )

    (:goal
        (and
            ;; (a) ontic completion + validation
            (completed task1)
            (completed task2)

            (validated task1)
            (validated task2)

            ;; (b) scheduler epistemic closure
            ([scheduler] (completed task1))
            ([scheduler] (completed task2))

            ;; (c) each tenant privately knows its own tasks
            ([tenant1] (completed task1))
            ([tenant3] (completed task2))

            ;; (d) privacy: non-owning tenant must not know
            (not ([tenant2] (completed task1)))
            (not ([tenant3] (completed task1)))
            (not ([tenant1] (completed task2)))
            (not ([tenant2] (completed task2)))
        )
    )
)
