(define (problem g-gos-04-all-sh2s4)  ;; 5 agents
    (:domain gossip)

    (:requirements
        :finitary-S5-theories :universal-goals :modal-goals
    )

    (:agents
        A B C D
    )

    (:init
        (:and
            ([C. All] ([Kw. B] (secret A)))
            ([C. All] ([Kw. B] (secret C)))
            (forall (?i - agent)
                (secret ?i) )
            ;; It is common knowledge that each agent knows whether her secret holds
            (:forall (?i - agent)
                ([C. All] ([Kw. ?i] (secret ?i))) ))
    )

    (:goal
        (forall (?i - agent)
            ([Kw. All] (secret ?i)) )
    )
)
