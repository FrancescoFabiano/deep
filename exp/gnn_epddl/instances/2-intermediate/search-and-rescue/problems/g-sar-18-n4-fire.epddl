;; Generated by gnn_epddl.generators.search_and_rescue (training/validation instance, not a benchmark problem)
;; Chain l0-..-l4; victim at l4; agents start at l1; fire=yes.
(define (problem g-sar-18-n4-fire)
  (:domain search-and-rescue)

  (:requirements
    :typing
    :equality
    :facts
    :partial-observability
    :multi-pointed-models
    :modal-goals
    :common-knowledge
    :finitary-S5-theories
    :list-comprehensions
  )

  (:objects
    l0 l1 l2 l3 l4 - location
  )

  (:agents
    D1
    F1
    A1
  )

  (:facts-init
    (adjacent l0 l1)
    (adjacent l1 l0)
    (adjacent l1 l2)
    (adjacent l2 l1)
    (adjacent l2 l3)
    (adjacent l3 l2)
    (adjacent l3 l4)
    (adjacent l4 l3)

    (is-drone D1)
    (is-ambulance A1)
    (is-firefighter F1)
  )

  (:init
    (:and
      (at D1 l1)
      (at F1 l1)
      (at A1 l1)
      (victim-at l4)
      (not (fire-at l0))
      (not (fire-at l1))
      (not (fire-at l2))
      (not (fire-at l3))
      (fire-at l4)
      (not (rescued-victim))

      (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
        (and
          (imply (at ?i ?l1) (not (at ?i ?l2)))
          (imply (victim-at ?l1) (not (victim-at ?l2)))))

      ([C. All] (and
        (at D1 l1)
        (at F1 l1)
        (at A1 l1)
        (not (fire-at l0))
        (not (fire-at l1))
        (not (fire-at l2))
        (not (fire-at l3))
        (not (rescued-victim))
        (forall (?i - agent ?l1 ?l2 - location | (/= ?l1 ?l2))
          (and
            (imply (at ?i ?l1) (not (at ?i ?l2)))
            (imply (victim-at ?l1) (not (victim-at ?l2)))))
      ))
    )
  )

  (:goal
    (and
      (rescued-victim)
    )
  )
)
