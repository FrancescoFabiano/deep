(define (problem g-bw-3-03-2-w2-s2)      ;; generated: 3 agents; 3 blocks; 2 tables; 2 worlds; seed 2 (training/validation only)
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 - block
        t1 t2 - table
    )

    (:agents
        A B C
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
    )

    (:init
        :worlds
            (w1 w2)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (on-table b3 t1)
                    (clear b3)
                    (on-table b2 t2)
                    (on b1 b2)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (on-table b2 t1)
                    (on b3 b2)
                    (clear b3)
                    (on-table b1 t2)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on b1 b3)
            ([B] (on-table b3 t2))
        )
    )
)
