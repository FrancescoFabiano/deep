(define (problem g-bw-4-05-2-w3-s1)      ;; generated: 4 agents; 5 blocks; 2 tables; 3 worlds; seed 1 (training/validation only)
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 - block
        t1 t2 - table
    )

    (:agents
        A B C D
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at D t2)
    )

    (:init
        :worlds
            (w1 w2 w3)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w))
             D (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (on-table b2 t1)
                    (on b1 b2)
                    (on b4 b1)
                    (on b5 b4)
                    (clear b5)
                    (on-table b3 t2)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (on-table b2 t1)
                    (clear b2)
                    (on-table b1 t2)
                    (on b3 b1)
                    (on b4 b3)
                    (on b5 b4)
                    (clear b5)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (on-table b2 t1)
                    (clear b2)
                    (on-table b5 t2)
                    (on b1 b5)
                    (on b3 b1)
                    (on b4 b3)
                    (clear b4)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on b1 b3)
            ([C] (on b3 b2))
            ([D]
                (and
                    (on-table b5 t1)
                    (on b4 b1) ))
            ([B] (on-table b2 t2))
        )
    )
)
