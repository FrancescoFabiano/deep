(define (problem g-gos-05-single)  ;; 5 agents
    (:domain gossip)

    (:requirements
        :finitary-S5-theories :universal-goals :modal-goals
    )

    (:agents
        A B C D E
    )

    (:init
        (:and
            (forall (?i - agent)
                (secret ?i) )
            ;; It is common knowledge that each agent knows whether her secret holds
            (:forall (?i - agent)
                ([C. All] ([Kw. ?i] (secret ?i))) ))
    )

    (:goal
        (forall (?i - agent)
            ([Kw. A] (secret ?i)) )
    )
)
