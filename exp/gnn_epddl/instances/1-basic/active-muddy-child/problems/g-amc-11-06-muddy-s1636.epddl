(define (problem g-amc-11-06-muddy-s1636)  ;; 11 children; 6 are muddy; child 1 is muddy (generated, seed 1636)
    (:domain active-muddy-child)

    (:requirements
        :equality :list-comprehensions
        :finitary-S5-theories :modal-goals
    )

    (:agents
        Child1 Child2 Child3 Child4 Child5 Child6 Child7 Child8 Child9 Child10 Child11
    )

    (:init
        (:and
            ;; Muddy children
            (muddy Child1) (muddy Child2) (muddy Child3) (muddy Child4) (muddy Child9) (muddy Child10)
            ;; It is common knowledge that at least one child is muddy
            ([C. All]
                (exists (?i - agent)
                    (muddy ?i) ))
            ;; It is common knowledge that all children know whether the others are muddy
            (:forall (?i ?j - agent | (/= ?i ?j))
                ([C. All]
                    ([Kw. ?i] (muddy ?j)) )))
    )

    (:goal
        ([Kw. Child1] (muddy Child1))
    )
)
