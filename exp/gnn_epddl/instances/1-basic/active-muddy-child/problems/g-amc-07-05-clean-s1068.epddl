(define (problem g-amc-07-05-clean-s1068)  ;; 7 children; 5 are muddy; child 1 is not muddy (generated, seed 1068)
    (:domain active-muddy-child)

    (:requirements
        :equality :list-comprehensions
        :finitary-S5-theories :modal-goals
    )

    (:agents
        Child1 Child2 Child3 Child4 Child5 Child6 Child7
    )

    (:init
        (:and
            ;; Muddy children
            (muddy Child3) (muddy Child4) (muddy Child5) (muddy Child6) (muddy Child7)
            ;; It is common knowledge that at least one child is muddy
            ([C. All]
                (exists (?i - agent)
                    (muddy ?i) ))
            ;; It is common knowledge that all children know whether the others are muddy
            (:forall (?i ?j - agent | (/= ?i ?j))
                ([C. All]
                    ([Kw. ?i] (muddy ?j)) )))
    )

    (:goal
        ([Kw. Child1] (muddy Child1))
    )
)
