;; Solution:
;;   0. right_A
;;   1. left_C
;;   2. sense_C
;;   3. tell_C

(define (problem sc-3-4)    ;; 3 agents; 4 rooms
    (:domain selective-communication)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
    )

    (:agents
        A B C
    )

    (:objects
        room1 room2 room3 room4 - room
    )

    (:facts-init
        (neighbor room1 room2)
        (neighbor room2 room3)
        (neighbor room3 room4)
        (leftmost room1)
        (rightmost room4)
    )

    (:init
        :worlds (w-info w-not-info)
        :relations
            (A (:forall (?x ?y - world) (?x ?y))
             A (:forall (?x ?y - world) (?x ?y))
             C (:forall (?x ?y - world) (?x ?y)) )
        :labels
            (w-info
                (:and
                    (info)
                    (at A room1)
                    (at B room2)
                    (at C room3)
                    (close A B)
                    (close B C)
                    (:forall (?i - agent)
                        (close ?i ?i) ))
             w-not-info
                (:and
                    (at A room1)
                    (at B room2)
                    (at C room3)
                    (close A B)
                    (close B C)
                    (:forall (?i - agent)
                        (close ?i ?i) )))
        :designated
            (w-info)
    )

    (:goal
        ([All] (info))
    )
)
