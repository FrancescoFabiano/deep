(define (problem sc-4-5)    ;; 4 agents; 5 rooms
    (:domain selective-communication)

    (:requirements
        :typing :equality :list-comprehensions
        :finitary-S5-theories :modal-goals :facts
    )

    (:agents
        A B C D
    )

    (:objects
        room1 room2 room3 room4 room5 - room
    )

    (:facts-init
        (neighbor room1 room2)
        (neighbor room2 room3)
        (neighbor room3 room4)
        (neighbor room4 room5)
        (leftmost room1)
        (rightmost room5)
    )

    (:init
        :worlds (w-info w-not-info)
        :relations
            (A (:forall (?x ?y - world) (?x ?y))
             A (:forall (?x ?y - world) (?x ?y))
             C (:forall (?x ?y - world) (?x ?y))
             D (:forall (?x ?y - world) (?x ?y)) )
        :labels
            (w-info
                (:and
                    (info)
                    (at A room1) (at B room2) (at C room3) (at D room4)
                    (close A B)  (close B C) (close C D)
                    (:forall (?i - agent)
                        (close ?i ?i) ))
             w-not-info
                (:and
                    (at A room1) (at B room2) (at C room3) (at D room4)
                    (close A B)  (close B C) (close C D)
                    (:forall (?i - agent)
                        (close ?i ?i) )))
        :designated
            (w-info)
    )

    (:goal
        ([All] (info))
    )
)
