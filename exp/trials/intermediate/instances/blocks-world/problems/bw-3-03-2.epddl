;; Solution:
;;    0. tell-block_A_C_b2_b1
;;    1. focus_C_C
;;    2. focus_B_A
;;    3. unstack_A_b2_b1
;;    4. put-down_A_b2_t1
;;    5. pick-up_A_b1_t1
;;    6. stack_A_b1_b2
;;    7. focus_C_A
;;    8. pick-up_A_b3_t1
;;    9. give_A_C_b3
;;   10. focus_C_C
;;   11. put-down_C_b3_t2

(define (problem bw-3-3-2)      ;; 3 agents; 3 blocks; 2 tables
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 - block
        t1 t2 - table
    )

    (:agents
        A B C
    )

    (:facts-init
        (at A t1) (at B t2) (at C t2)
    )

    (:init
        :worlds
            (w1 w2 w3)
        :relations
            (A (:forall (?w      - world) (?w  ?w ))
             B (:forall (?w1 ?w2 - world) (?w1 ?w2))
             C (:forall (?w1 ?w2 - world) (?w1 ?w2)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C A)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (on-table b1 t1)
                    (on b2 b1)
                    (on-table b3 t1)
                    (clear b2)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C) )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C A)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (on-table b1 t1)
                    (on-table b2 t1)
                    (on-table b3 t1)
                    (clear b1)
                    (clear b2)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C) )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C A)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (on b1 b2)
                    (on-table b2 t1)
                    (on-table b3 t1)
                    (clear b1)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C) ))
        :designated (w1)
    )

    (:goal
        (and
            ([B] (on b1 b2))
            ([C] (on b2 b1))
            (on-table b3 t2)
        )
    )
)
