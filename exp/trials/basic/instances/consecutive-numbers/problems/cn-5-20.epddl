(define (problem cn-5-20)    ;; 5 agents, N = 20
    (:domain consecutive-numbers)

    (:requirements
        :typing :equality :list-comprehensions :facts :finitary-S5-theories
        :negative-list-formulas :modal-goals
    )

    (:objects
        n0  n1  n2  n3  n4
        n5  n6  n7  n8  n9
        n10 n11 n12 n13 n14
        n15 n16 n17 n18 n19 n20 - number
    )

    (:agents
        A B C D E
    )

    (:facts-init
        (consecutive n0  n1 ) (consecutive n1  n2 ) (consecutive n2  n3 )
        (consecutive n3  n4 ) (consecutive n4  n5 ) (consecutive n5  n6 )
        (consecutive n6  n7 ) (consecutive n7  n8 ) (consecutive n8  n9 )
        (consecutive n9  n10) (consecutive n10 n11) (consecutive n11 n12)
        (consecutive n12 n13) (consecutive n13 n14) (consecutive n14 n15)
        (consecutive n15 n16) (consecutive n16 n17) (consecutive n17 n18)
        (consecutive n18 n19) (consecutive n19 n20)
        ;; Numbers assignable to A
        (assignable A n0 ) (assignable A n5 ) (assignable A n10) (assignable A n15) (assignable A n20)
        ;; Numbers assignable to B
        (assignable B n1 ) (assignable B n6 ) (assignable B n11) (assignable B n16)
        ;; Numbers assignable to C
        (assignable C n2 ) (assignable C n7 ) (assignable C n12) (assignable C n17)
        ;; Numbers assignable to D
        (assignable D n3 ) (assignable D n8 ) (assignable D n13) (assignable D n18)
        ;; Numbers assignable to E
        (assignable E n4 ) (assignable E n9 ) (assignable E n14) (assignable E n19)
    )

    (:init
        (:and
            ; Actual assignment
            (has A n5)
            (has B n6)
            (has C n7)
            (has D n8)
            (has E n9)
            ; A and B have each an assignable number, and the numbers are consecutive
            ([C. All]
                (and
                    (exists (?i ?j - agent
                             ?m ?n - number |
                        (and
                            (assignable ?i ?m)
                            (assignable ?j ?n)
                            (consecutive ?m ?n) ))
                        (and
                            (has ?i ?m)
                            (has ?j ?n) ))
                    (forall (?i - agent
                             ?n - number |
                                (not (assignable ?i ?n)) )
                        (not (has ?i ?n)) )))
            ; Agents have at most one number
            ([C. All]
                (forall (?i - agent
                         ?m ?n - number |
                            (/= ?m ?n))
                    (imply
                        (has ?i ?m)
                        (not (has ?i ?n)) )))
            ; Agents know their number
            (:forall (?i - agent
                      ?n - number)
                ([C. All]
                    ([Kw. ?i] (has ?i ?n)) )))
    )

    (:goal
        (and
            ([B] ([All] (has B n4)))
            ([C] ([All] (has C n5)))
            ([D] ([All] (has D n6)))
            ([E] ([All] (has E n7))) )
    )
)
