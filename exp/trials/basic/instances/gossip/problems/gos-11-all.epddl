(define (problem gos-11-all)  ;; 11 agents
    (:domain gossip)

    (:requirements
        :finitary-S5-theories :universal-goals :modal-goals
    )

    (:agents
        A B C D E F G H I J K
    )

    (:init
        (:and
            (forall (?i - agent)
                (secret ?i) )
            ;; It is common knowledge that each agent knows whether her secret holds
            (:forall (?i - agent)
                ([C. All] ([Kw. ?i] (secret ?i))) ))
    )

    (:goal
        (forall (?i - agent)
            ([Kw. All] (secret ?i)) )
    )
)
