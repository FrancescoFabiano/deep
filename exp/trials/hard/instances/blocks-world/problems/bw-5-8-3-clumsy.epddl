(define (problem bw-5-8-3)      ;; 5 agents; 8 blocks; 3 tables
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 b6 b7 b8 - block
        t1 t2 t3 - table
    )

    (:agents
        A B C D E
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at D t2)
        (at E t3)
    )

    (:init
        :worlds
            (w1 w2 w3 w4)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w))
             D (:forall (?w - world) (?w ?w))
             E (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b3)
                    (can-move C b3)
                    (can-move B b1)
                    (can-move B b6)
                    (can-move B b4)
                    (can-move D b1)
                    (can-move D b6)
                    (can-move D b4)
                    (can-move E b8)
                    (can-move E b2)
                    (can-move E b5)
                    (can-move E b7)
                    (on-table b3 t1)
                    (clear b3)
                    (on-table b1 t2)
                    (on b6 b1)
                    (on b4 b6)
                    (clear b4)
                    (on-table b8 t3)
                    (on b2 b8)
                    (on b5 b2)
                    (on b7 b5)
                    (clear b7)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b8)
                    (can-move A b4)
                    (can-move A b6)
                    (can-move C b8)
                    (can-move C b4)
                    (can-move C b6)
                    (can-move B b5)
                    (can-move B b2)
                    (can-move B b3)
                    (can-move D b5)
                    (can-move D b2)
                    (can-move D b3)
                    (can-move E b1)
                    (can-move E b7)
                    (on-table b8 t1)
                    (on b4 b8)
                    (on b6 b4)
                    (clear b6)
                    (on-table b5 t2)
                    (on b2 b5)
                    (on b3 b2)
                    (clear b3)
                    (on-table b1 t3)
                    (on b7 b1)
                    (clear b7)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b5)
                    (can-move A b2)
                    (can-move A b4)
                    (can-move C b5)
                    (can-move C b2)
                    (can-move C b4)
                    (can-move B b1)
                    (can-move B b3)
                    (can-move B b7)
                    (can-move B b8)
                    (can-move D b1)
                    (can-move D b3)
                    (can-move D b7)
                    (can-move D b8)
                    (can-move E b6)
                    (can-move E b4)
                    (on-table b5 t1)
                    (on b2 b5)
                    (clear b2)
                    (on-table b1 t2)
                    (on b3 b1)
                    (on b7 b3)
                    (on b8 b7)
                    (clear b8)
                    (on-table b6 t3)
                    (on b4 b6)
                    (clear b4)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w4
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b5)
                    (can-move A b2)
                    (can-move A b4)
                    (can-move C b5)
                    (can-move C b2)
                    (can-move C b4)
                    (can-move B b8)
                    (can-move D b8)
                    (can-move E b6)
                    (can-move E b7)
                    (can-move E b3)
                    (can-move E b1)
                    (on-table b5 t1)
                    (on b2 b5)
                    (on b4 b2)
                    (clear b4)
                    (on-table b8 t2)
                    (clear b8)
                    (on-table b6 t3)
                    (on b7 b6)
                    (on b3 b7)
                    (on b1 b3)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on-table b2 t2)
            ([B] (on b5 b2))
            ([C] (on-table b7 t3))
            ([D] (on b1 b4))
            ([E] (on b8 b6))
        )
    )
)
