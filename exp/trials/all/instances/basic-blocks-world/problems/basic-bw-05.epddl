(define (problem bw-5)
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :lists
    )

    (:objects
        b1 b2 b3 b4 b5 - block
    )
    
    (:init
        :worlds
            (w)
        :relations
            (Robot (w w))
        :labels
            (w
                (:and
                    (on-table b1)
                    (on-table b5)
                    (on b2 b5)
                    (on b4 b2)
                    (on-table b3)
                    (clear b1)
                    (clear b4)
                    (clear b3)
                    (arm-empty)) )
        :designated (w)
    )

    (:goal
        (and
            (on-table b2)
            (on b1 b2)
            (on b4 b1)
            (on b5 b4)
            (on b3 b5)
        )
    )
)
