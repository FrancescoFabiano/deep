(define (problem cn-2-5)    ;; 2 agents, N = 5
    (:domain consecutive-numbers)

    (:requirements
        :typing :equality :list-comprehensions :facts :finitary-S5-theories
        :negative-list-formulas :modal-goals
    )

    (:objects
        n0 n1 n2 n3 n4 n5 - number
    )

    (:agents A B)

    (:facts-init
        (consecutive n0 n1)
        (consecutive n1 n2)
        (consecutive n2 n3)
        (consecutive n3 n4)
        (consecutive n4 n5)
        ;; Numbers assignable to A
        (assignable A n1) (assignable A n3) (assignable A n5)
        ;; Numbers assignable to B
        (assignable B n0) (assignable B n2) (assignable B n4)
    )

    (:init
        (:and
            ; Numbers assignment from agent B's perspective
            (has B n4)
            ; A and B have each an assignable number, and the numbers are consecutive
            ([C. All]
                (and
                    (exists (?i ?j - agent
                             ?m ?n - number |
                        (and
                            (assignable ?i ?m)
                            (assignable ?j ?n)
                            (consecutive ?m ?n) ))
                        (and
                            (has ?i ?m)
                            (has ?j ?n) ))
                    (forall (?i - agent
                             ?n - number |
                                (not (assignable ?i ?n)) )
                        (not (has ?i ?n)) )))
            ; Agents have at most one number
            ([C. All]
                (forall (?i - agent
                         ?m ?n - number |
                            (/= ?m ?n))
                    (imply
                        (has ?i ?m)
                        (not (has ?i ?n)) )))
            ; Agents know their number
            (:forall (?i - agent
                      ?n - number)
                ([C. All]
                    ([Kw. ?i] (has ?i ?n)) )))
    )

    (:goal
        ([B] ([A] (has B n4)))
    )
)
