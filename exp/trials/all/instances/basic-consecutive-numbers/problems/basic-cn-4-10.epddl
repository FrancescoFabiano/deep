(define (problem cn-4-10)    ;; 4 agents, N = 10
    (:domain consecutive-numbers)

    (:requirements
        :typing :equality :list-comprehensions :facts :finitary-S5-theories
        :negative-list-formulas :modal-goals
    )

    (:objects
        n0  n1  n2  n3  n4
        n5  n6  n7  n8  n9 n10 - number
    )

    (:agents
        A B C D
    )

    (:facts-init
        (consecutive n0  n1 ) (consecutive n1  n2 ) (consecutive n2  n3 )
        (consecutive n3  n4 ) (consecutive n4  n5 ) (consecutive n5  n6 )
        (consecutive n6  n7 ) (consecutive n7  n8 ) (consecutive n8  n9 )
        (consecutive n9  n10)
        ;; Numbers assignable to A
        (assignable A n0 ) (assignable A n4 ) (assignable A n8 )
        ;; Numbers assignable to B
        (assignable B n1 ) (assignable B n5 ) (assignable B n9 )
        ;; Numbers assignable to C
        (assignable C n2 ) (assignable C n6 ) (assignable C n10)
        ;; Numbers assignable to D
        (assignable D n3 ) (assignable D n7 )
    )

    (:init
        (:and
            ; Actual assignment
            (has A n4)
            (has B n5)
            (has C n6)
            (has D n7)
            ; A and B have each an assignable number, and the numbers are consecutive
            ([C. All]
                (and
                    (exists (?i1 ?i2 ?i3 - agent
                             ?n1 ?n2 ?n3 - number |
                        (and
                            (assignable  ?i1 ?n1)
                            (assignable  ?i2 ?n2)
                            (assignable  ?i3 ?n3)
                            (consecutive ?n1 ?n2)
                            (consecutive ?n2 ?n3) ))
                        (and
                            (has ?i1 ?n1)
                            (has ?i2 ?n2)
                            (has ?i3 ?n3) ))
                    (forall (?i - agent
                             ?n - number |
                                (not (assignable ?i ?n)) )
                        (not (has ?i ?n)) )))
            ; Agents have at most one number
            ([C. All]
                (forall (?i - agent
                         ?m ?n - number |
                            (/= ?m ?n))
                    (imply
                        (has ?i ?m)
                        (not (has ?i ?n)) )))
            ; Agents know their number
            (:forall (?i - agent
                      ?n - number)
                ([C. All]
                    ([Kw. ?i] (has ?i ?n)) )))
    )

    (:goal
        (and
            ([B] ([All] (has B n4)))
            ([C] ([All] (has C n5)))
            ([D] ([All] (has D n6))) )
    )
)
