(define (problem bw-3-5-2-clumsy)      ;; 3 agents; 5 blocks; 2 tables
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 - block
        t1 t2 - table
    )

    (:agents
        A    - precise-agent
        B C  - clumsy-agent
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at C t2)
    )

    (:init
        :worlds
            (w1 w2)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (on-table b5 t1)
                    (on b4 b5)
                    (on b3 b4)
                    (clear b3)
                    (on-table b1 t2)
                    (on b2 b1)
                    (clear b2)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (on-table b1 t1)
                    (on b5 b1)
                    (clear b5)
                    (on-table b4 t2)
                    (on b3 b4)
                    (on b2 b3)
                    (clear b2)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                )
            )
        :designated (w1)
    )

    (:goal
        ([C]
            (and
                (on-table b4 t1)
                (or
                    (on b2 b1)
                    (on-table b1 t2) )
                (or
                    (on b3 b2)
                    (on-table b3 t2) )
                (or
                    (on b5 b4)
                    (on-table b4 t2) )))
    )
)
