(define (problem bw-4-6-3)      ;; 4 agents; 6 blocks; 3 tables
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 b6 - block
        t1 t2 t3 - table
    )

    (:agents
        A B C D
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at D t2)
    )

    (:init
        :worlds
            (w1 w2 w3)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w))
             D (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (on-table b4 t1)
                    (on b5 b4)
                    (on b2 b5)
                    (clear b2)
                    (on-table b3 t2)
                    (clear b3)
                    (on-table b6 t3)
                    (on b1 b6)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (on-table b1 t1)
                    (on b4 b1)
                    (clear b4)
                    (on-table b6 t2)
                    (on b2 b6)
                    (on b3 b2)
                    (clear b3)
                    (on-table b5 t3)
                    (clear b5)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (on-table b4 t1)
                    (clear b4)
                    (on-table b2 t2)
                    (on b3 b2)
                    (on b5 b3)
                    (on b1 b5)
                    (clear b1)
                    (on-table b6 t3)
                    (clear b6)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on b5 b4)
            ([B] (on-table b5 t1))
            ([C] (on-table b5 t2))
            ([D]
                (and
                    (on b3 b4)
                    (on b4 b5) )))
    )
)
