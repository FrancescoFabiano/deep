(define (problem bw-5-10-3)      ;; 5 agents; 10 blocks; 3 tables
    (:domain blocks-world)

    (:requirements
        :finitary-S5-theories :typing :equality
        :lists :list-comprehensions :facts
        :negative-goals :modal-goals :disjunctive-list-formulas
    )

    (:objects
        b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 - block
        t1 t2 t3 - table
    )

    (:agents
        A B C D E
    )

    (:facts-init
        (at A t1)
        (at B t2)
        (at C t1)
        (at D t2)
        (at E t3)
    )

    (:init
        :worlds
            (w1 w2 w3 w4)
        :relations
            (A (:forall (?w1 ?w2 - world) (?w1 ?w2))
             B (:forall (?w - world) (?w ?w))
             C (:forall (?w - world) (?w ?w))
             D (:forall (?w - world) (?w ?w))
             E (:forall (?w - world) (?w ?w)) )
        :labels
            (w1
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (can-move A b7)
                    (can-move A b8)
                    (can-move A b9)
                    (can-move A b10)
                    (on-table b1 t1)
                    (clear b1)
                    (on-table b9 t2)
                    (on b7 b9)
                    (clear b7)
                    (on-table b2 t3)
                    (on b5 b2)
                    (on b6 b5)
                    (on b4 b6)
                    (on b8 b4)
                    (on b10 b8)
                    (on b3 b10)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w2
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (can-move A b7)
                    (can-move A b8)
                    (can-move A b9)
                    (can-move A b10)
                    (on-table b1 t1)
                    (on b9 b1)
                    (clear b9)
                    (on-table b5 t2)
                    (on b7 b5)
                    (on b2 b7)
                    (clear b2)
                    (on-table b8 t3)
                    (on b10 b8)
                    (on b4 b10)
                    (on b6 b4)
                    (on b3 b6)
                    (clear b3)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w3
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (can-move A b7)
                    (can-move A b8)
                    (can-move A b9)
                    (can-move A b10)
                    (on-table b10 t1)
                    (on b4 b10)
                    (on b2 b4)
                    (on b7 b2)
                    (clear b7)
                    (on-table b8 t2)
                    (on b3 b8)
                    (on b6 b3)
                    (clear b6)
                    (on-table b5 t3)
                    (on b1 b5)
                    (on b9 b1)
                    (clear b9)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
             w4
                (:and
                    (focused-on A A)
                    (focused-on B B)
                    (focused-on C C)
                    (focused-on D D)
                    (focused-on E E)
                    (can-move A b1)
                    (can-move A b2)
                    (can-move A b3)
                    (can-move A b4)
                    (can-move A b5)
                    (can-move A b6)
                    (can-move A b7)
                    (can-move A b8)
                    (can-move A b9)
                    (can-move A b10)
                    (on-table b7 t1)
                    (on b6 b7)
                    (on b10 b6)
                    (clear b10)
                    (on-table b4 t2)
                    (on b8 b4)
                    (on b2 b8)
                    (on b9 b2)
                    (on b3 b9)
                    (clear b3)
                    (on-table b5 t3)
                    (on b1 b5)
                    (clear b1)
                    (arm-empty A)
                    (arm-empty B)
                    (arm-empty C)
                    (arm-empty D)
                    (arm-empty E)
                )
            )
        :designated (w1)
    )

    (:goal
        (and
            (on-table b2 t2)
            ([B] (on b3 b1))
            ([C]
                (and
                    (on b9 b8)
                    (on-table b4 t3) ))
            ([D]
                (and
                    (on b10 b7)
                    (on b5 b4) ))
            ([E] ([B] (on-table b6 t1)))
        )
    )
)
