(define (problem amc-9-5-clean)  ;; 9 children; 5 are muddy; child 1 is not muddy
    (:domain active-muddy-child)

    (:requirements
        :equality :list-comprehensions
        :finitary-S5-theories :modal-goals
    )

    (:agents
        Child1 Child2 Child3 Child4 Child5
        Child6 Child7 Child8 Child9
    )

    (:init
        (:and
            ;; Children 5 to 9 are muddy
            (muddy Child5) (muddy Child6) (muddy Child7) (muddy Child8) (muddy Child9)
            ;; It is common knowledge that at least one child is muddy
            ([C. All]
                (exists (?i - agent)
                    (muddy ?i) ))
            ;; It is common knowledge that all children know whether the others are muddy
            (:forall (?i ?j - agent | (/= ?i ?j))
                ([C. All]
                    ([Kw. ?i] (muddy ?j)) )))
    )

    (:goal
        ([Kw. Child1] (muddy Child1))
    )
)
